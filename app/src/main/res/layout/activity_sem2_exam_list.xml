<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".sem2.Sem2ExamList">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:layout_marginTop="50dp"
            android:fontFamily="@font/roboto_regular"
            android:gravity="center"
            android:padding="5dp"
            android:text="@string/semester_two_exams"
            android:textSize="20sp" />


        <Button
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_margin="20dp"
            android:background="@drawable/btn_bg"
            android:elevation="5dp"
            android:fontFamily="@font/roboto_regular"
            android:onClick="javaExam"
            android:text="@string/java"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_color"
            android:textSize="17sp"
            tools:ignore="UsingOnClickInXml"
            tools:targetApi="lollipop" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_margin="20dp"
            android:background="@drawable/btn_bg"
            android:elevation="5dp"
            android:fontFamily="@font/roboto_regular"
            android:onClick="CSharpExam"
            android:text="@string/c_sharp"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_color"
            android:textSize="17sp"
            tools:ignore="UsingOnClickInXml"
            tools:targetApi="lollipop" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_margin="20dp"
            android:background="@drawable/btn_bg"
            android:elevation="5dp"
            android:fontFamily="@font/roboto_regular"
            android:onClick="ReadHatExam"
            android:text="@string/liunx_read_hat"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_color"
            android:textSize="17sp"
            tools:ignore="UsingOnClickInXml"
            tools:targetApi="lollipop" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_margin="20dp"
            android:background="@drawable/btn_bg"
            android:elevation="5dp"
            android:fontFamily="@font/roboto_regular"
            android:onClick="SEOExam"
            android:text="@string/seo"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_color"
            android:textSize="17sp"
            tools:ignore="UsingOnClickInXml"
            tools:targetApi="lollipop" />


        <Button
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_margin="20dp"
            android:background="@drawable/btn_bg"
            android:elevation="5dp"
            android:fontFamily="@font/roboto_regular"
            android:onClick="IOTExam"
            android:text="@string/iot"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_color"
            android:textSize="17sp"
            tools:ignore="UsingOnClickInXml"
            tools:targetApi="lollipop" />

    </LinearLayout>
</ScrollView>