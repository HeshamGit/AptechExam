<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".activities.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="15dp"
            android:fontFamily="@font/roboto_regular"
            android:gravity="center"
            android:padding="5dp"
            android:text="@string/app_name"
            android:textColor="@color/darkBlack"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Interactive Exam Portal Highlight Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="25dp"
            android:background="@drawable/btn_interactive_bg"
            android:elevation="6dp"
            android:onClick="goToInteractivePortal"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:text="🎓 Interactive Exam Portal"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/roboto_regular"
                android:lineSpacingExtra="2dp"
                android:text="• Official Timed Exam Simulation with Scorecard\n• 1-Question Practice with Instant Feedback"
                android:textColor="#FEE2E2"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:background="#33FFFFFF"
                android:fontFamily="@font/roboto_regular"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="Launch Portal →"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/roboto_regular"
            android:text="Browse by Semester"
            android:textColor="@color/gray"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="8dp"
            android:background="@drawable/btn_bg"
            android:elevation="4dp"
            android:fontFamily="@font/roboto_regular"
            android:onClick="goToSem1"
            android:text="@string/semester_one"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_color"
            android:textSize="17sp"
            tools:ignore="UsingOnClickInXml"
            tools:targetApi="lollipop" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="8dp"
            android:background="@drawable/btn_bg"
            android:elevation="4dp"
            android:fontFamily="@font/roboto_regular"
            android:onClick="goToSem2"
            android:text="@string/semester_two"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_color"
            android:textSize="17sp"
            tools:ignore="UsingOnClickInXml"
            tools:targetApi="lollipop" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="8dp"
            android:background="@drawable/btn_bg"
            android:elevation="4dp"
            android:fontFamily="@font/roboto_regular"
            android:onClick="goToSem3"
            android:text="@string/semester_three"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_color"
            android:textSize="17sp"
            tools:ignore="UsingOnClickInXml"
            tools:targetApi="lollipop" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="8dp"
            android:background="@drawable/btn_bg"
            android:elevation="4dp"
            android:fontFamily="@font/roboto_regular"
            android:onClick="goToSem4"
            android:text="@string/semester_four"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_color"
            android:textSize="17sp"
            tools:ignore="UsingOnClickInXml"
            tools:targetApi="lollipop" />

    </LinearLayout>
</ScrollView>
